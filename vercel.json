{
  "framework": "nextjs",
  "buildCommand": "next build",
  "headers": [
    {
      "source": "/journal(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, stale-while-revalidate=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, stale-while-revalidate=0, must-revalidate"
        }
      ]
    }
  ]
}