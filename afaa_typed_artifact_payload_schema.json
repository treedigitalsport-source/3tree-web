{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFAA_Typed_Artifact_Payload",
  "type": "object",
  "required": [
    "artifact_id",
    "protocol_version",
    "issuer_agent_id",
    "target_agent_id",
    "timestamp_utc",
    "payload_type",
    "data_payload",
    "delivery_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Unique identifier (e.g., ART-20260821-001)"
    },
    "protocol_version": {
      "type": "string",
      "default": "AFAA_v3.0"
    },
    "issuer_agent_id": {
      "type": "string",
      "description": "ID of the agent producing this artifact (e.g., AG-021)"
    },
    "target_agent_id": {
      "type": "string",
      "description": "ID of the destination agent or 'ALL' for broadcasts (e.g., AG-013)"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "payload_type": {
      "type": "string",
      "enum": [
        "code_pull_request",
        "qa_test_report",
        "biomechanics_telemetry",
        "marketing_copy",
        "financial_audit",
        "legal_notice"
      ]
    },
    "data_payload": {
      "type": "object",
      "description": "Structured deliverable content without exposing raw internal memory"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_REVIEW",
        "APPROVED",
        "COMPLETED"
      ]
    }
  }
}
